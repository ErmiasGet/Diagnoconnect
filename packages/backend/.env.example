# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diagnosconnect

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@diagnosconnect.com

# Frontend URLs
PATIENT_PORTAL_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5174
RECEPTION_APP_URL=http://localhost:5175

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Payment - ArifPay
ARIFPAY_API_KEY=
ARIFPAY_MERCHANT_ID=

# Payment - Chapa
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=

# Payment - Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Video Consultation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=

# SMS
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
