// DiagnoConnect - Enterprise Healthcare SaaS Platform
// Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-TENANT & ORGANIZATION
// ============================================================

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  type          OrgType
  logo          String?
  coverImage    String?
  phone         String?
  email         String?
  website       String?
  address       Json?
  city          String?
  state         String?
  country       String?  @default("ET")
  timezone      String?  @default("Africa/Addis_Ababa")
  currency      String?  @default("ETB")
  taxRate       Decimal? @default(0) @db.Decimal(5, 2)
  settings      Json?
  branding      Json?
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription  Subscription?
  users         User[]
  patients      Patient[]
  departments   Department[]
  doctorProfiles DoctorProfile[]
  appointments  Appointment[]
  visits        Visit[]
  queues        Queue[]
  laboratories  Laboratory[]
  tests         Test[]
  medicines     Medicine[]
  invoices      Invoice[]
  notifications Notification[]
  auditLogs     AuditLog[]
  settings_list OrganizationSetting[]
  rooms         Room[]
  prescriptions Prescription[]
  labResults    LabResult[]
  radiologyReports RadiologyReport[]
  insuranceProviders InsuranceProvider[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims InsuranceClaim[]
  chatRooms     ChatRoom[]
  videoSessions VideoSession[]
  files         File[]
  reports       Report[]
  medicationReminders MedicationReminder[]
  vaccinationRecords VaccinationRecord[]
  emergencyContacts EmergencyContact[]
  familyAccounts FamilyAccount[]
  favoriteDoctors FavoriteDoctor[]
  doctorSchedules DoctorSchedule[]
  doctorScheduleOverrides DoctorScheduleOverride[]
  waitingList   WaitingList[]
  feedback      Feedback[]

  @@map("organizations")
}

enum OrgType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  PHARMACY
  PRIVATE_PRACTICE
  LABORATORY
  RADIOLOGY_CENTER
  DENTAL_CLINIC
  EYE_CLINIC
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id              String    @id @default(uuid())
  organizationId  String?
  email           String?
  phone           String?
  password        String
  firstName       String
  lastName        String
  avatar          String?
  role            UserRole
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  preferredLanguage String? @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  doctorProfile   DoctorProfile?
  patientProfile  Patient?
  receptionProfile ReceptionProfile?
  nurseProfile    NurseProfile?
  pharmacistProfile PharmacistProfile?
  labTechProfile  LabTechnicianProfile?
  radiologistProfile RadiologistProfile?
  cashierProfile  CashierProfile?
  insuranceOfficerProfile InsuranceOfficerProfile?
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdVisits   Visit[]        @relation("VisitCreator")
  assignedVisits  Visit[]        @relation("VisitDoctor")
  appointments    Appointment[]  @relation("UserAppointmentCreator")
  prescriptions   Prescription[] @relation("PrescriptionCreator")
  labTestsOrdered Test[]         @relation("LabTestsOrderer")
  labTestResults  LabTestResult[]  @relation("LabResultTechnician")
  labResultApprovals LabResult[] @relation("LabResultApprover")
  radiologyRequests RadiologyRequest[] @relation("RadiologyRequester")
  radiologyReportApprovals RadiologyReport[] @relation("RadiologyReportApprover")
  invoicesCreated Invoice[]      @relation("InvoiceCreator")
  paymentsProcessed Payment[]    @relation("PaymentProcessor")
  chatRooms       UserChatRoom[]
  videoSessions   VideoSession[]
  sentMessages    ChatMessage[]
  medicalRecords  MedicalRecord[]
  soapNotes       SOAPNote[]
  clinicalDecisionSupports ClinicalDecisionSupport[] @relation("CDSCreator")
  doctorSchedules DoctorSchedule[]   @relation("UserDoctorSchedule")
  doctorScheduleOverrides DoctorScheduleOverride[] @relation("UserDoctorScheduleOverride")
  labRequests     LabRequest[]  @relation("LabRequestCreator")
  procedureRequests ProcedureRequest[] @relation("UserProcedureRequest")
  referrals       Referral[]     @relation("ReferralCreator")
  receivedReferrals Referral[]   @relation("ReferralReceiver")
  admissionRequests AdmissionRequest[] @relation("UserAdmissionRequest")
  medicalCertificates MedicalCertificate[] @relation("UserMedicalCertificate")
  voiceNotes      VoiceNote[]    @relation("UserVoiceNote")
  activityLogs    ActivityLog[]
  reports         Report[]
  feedback        Feedback[]
  roleAssignments UserRoleAssignment[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_TECHNICIAN
  RADIOLOGIST
  NURSE
  PHARMACIST
  CASHIER
  INSURANCE_OFFICER
  PATIENT
  SUPPORT
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  deviceInfo String?
  ip        String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  code      String
  purpose   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otps")
}

// ============================================================
// USER PROFILES (Role-Specific)
// ============================================================

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  departmentId    String?
  licenseNumber   String?
  specialty       String
  subSpecialty    String?
  qualifications  Json?
  experience      Int?
  consultationFee Decimal? @db.Decimal(10, 2)
  followUpFee     Decimal? @db.Decimal(10, 2)
  bio             String?
  languages       String[] @default(["en"])
  rating          Decimal? @default(0) @db.Decimal(3, 2)
  totalRatings    Int      @default(0)
  isAcceptingPatients Boolean @default(true)
  isTelemedicineEnabled Boolean @default(true)
  maxPatientsPerDay Int?  @default(30)
  slotDuration    Int?     @default(30)
  availableDays   String[] @default(["Mon","Tue","Wed","Thu","Fri"])
  startTime       String?  @default("09:00")
  endTime         String?  @default("17:00")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?    @relation("DepartmentDoctorProfiles", fields: [departmentId], references: [id], onDelete: SetNull)
  schedules       DoctorSchedule[]
  scheduleOverrides DoctorScheduleOverride[]
  appointments    Appointment[]
  consultations   Consultation[]
  soapNotes       SOAPNote[]
  prescriptions   Prescription[] @relation("DoctorPrescriptions")
  labRequests     LabRequest[]   @relation("DoctorLabRequests")
  radiologyRequests RadiologyRequest[] @relation("DoctorRadiologyRequests")
  procedureRequests ProcedureRequest[] @relation("DoctorProcedureRequests")
  referralsCreated Referral[]    @relation("ReferralCreatorDoc")
  referralsReceived Referral[]   @relation("ReferralReceiverDoc")
  admissionRequests AdmissionRequest[] @relation("DoctorAdmissionRequest")
  medicalCertificates MedicalCertificate[] @relation("DoctorMedicalCertificate")
  clinicalDecisionSupports ClinicalDecisionSupport[] @relation("DoctorCDS")
  favoriteDoctors FavoriteDoctor[]
  waitingList     WaitingList[]
  feedback        Feedback[]

  @@map("doctor_profiles")
}

model ReceptionProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  stationNumber   Int?
  canRegister     Boolean  @default(true)
  canSchedule     Boolean  @default(true)
  canProcessPayments Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reception_profiles")
}

model NurseProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  departmentId    String?
  licenseNumber   String?
  shift           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vitalsRecorded  VitalsRecord[] @relation("NurseVitals")

  @@map("nurse_profiles")
}

model PharmacistProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  licenseNumber   String?
  canDispense     Boolean  @default(true)
  canManageInventory Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispensedPrescriptions Prescription[] @relation("PharmacistDispensedPrescriptions")

  @@map("pharmacist_profiles")
}

model LabTechnicianProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  departmentId    String?
  canCollectSamples Boolean @default(true)
  canEnterResults Boolean  @default(true)
  canApproveResults Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedSamples SampleCollection[] @relation("LabTechCollectedSamples")
  enteredResults  LabTestResult[] @relation("LabTechEnteredResults")

  @@map("lab_technician_profiles")
}

model RadiologistProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  licenseNumber   String?
  canApproveReports Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("radiologist_profiles")
}

model CashierProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  stationNumber   Int?
  canProcessRefunds Boolean @default(true)
  maxRefundAmount Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cashier_profiles")
}

model InsuranceOfficerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organizationId  String
  canApproveClaims Boolean @default(true)
  maxApprovalAmount Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insurance_officer_profiles")
}

// ============================================================
// PERMISSIONS & ROLES (System Level)
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isSystemRole    Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permissions     RolePermission[]
  users           UserRoleAssignment[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id                    String   @id @default(uuid())
  organizationId        String
  medicalRecordNumber   String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                Gender
  bloodGroup            BloodGroup?
  maritalStatus         MaritalStatus?
  nationality           String?
  ethnicity             String?
  photo                 String?
  phone                 String?
  alternatePhone        String?
  email                 String?
  address               Json?
  city                  String?
  state                 String?
  country               String?
  occupation            String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  insuranceCardNumber   String?
  allergies             String[] @default([])
  chronicConditions     String[] @default([])
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  guardianName          String?
  guardianPhone         String?
  guardianRelation      String?
  notes                 String?
  isActive              Boolean  @default(true)
  isDeceased            Boolean  @default(false)
  deceasedAt            DateTime?
  registrationDate      DateTime @default(now())
  lastVisitAt           DateTime?
  totalVisits           Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?      @unique
  visits                Visit[]
  appointments          Appointment[]
  prescriptions         Prescription[]
  labResults            LabResult[]
  labTestResults        LabTestResult[]
  radiologyRequests     RadiologyRequest[]
  radiologyReports      RadiologyReport[]
  medicalRecords        MedicalRecord[]
  soapNotes             SOAPNote[]
  invoices              Invoice[]
  insurancePolicies     InsurancePolicy[]
  insuranceClaims       InsuranceClaim[]
  vitalsRecords         VitalsRecord[]
  files                 File[]
  emergencyContacts     EmergencyContact[]
  familyAccounts        FamilyAccount[] @relation("FamilyAccount")
  patientFamilyAccounts FamilyAccount[] @relation("patientFamilyAccounts")
  favoriteDoctors       FavoriteDoctor[]
  medicationReminders   MedicationReminder[]
  vaccinationRecords    VaccinationRecord[]
  waitingList           WaitingList[]
  procedureRequests     ProcedureRequest[]
  admissionRequests     AdmissionRequest[]
  medicalCertificates   MedicalCertificate[]
  chatRooms             PatientChatRoom[]
  feedback              Feedback[]
  queues                Queue[]
  clinicalDecisionSupports ClinicalDecisionSupport[]

  @@unique([organizationId, medicalRecordNumber])
  @@index([organizationId, firstName, lastName])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// ============================================================
// DEPARTMENTS & ROOMS
// ============================================================

model Department {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  code            String
  description     String?
  color           String?
  icon            String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visits          Visit[]
  rooms           Room[]
  doctorProfiles  DoctorProfile[] @relation("DepartmentDoctorProfiles")
  labTests        Test[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Room {
  id              String   @id @default(uuid())
  organizationId  String
  departmentId    String?
  name            String
  number          String
  type            RoomType
  floor           Int?
  capacity        Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  queues          Queue[]

  @@unique([organizationId, number])
  @@map("rooms")
}

enum RoomType {
  CONSULTATION
  EXAMINATION
  LABORATORY
  RADIOLOGY
  PHARMACY
  SURGERY
  EMERGENCY
  RECEPTION
  WAITING
  WARD
  ICU
  OPD
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id              String   @id @default(uuid())
  organizationId  String
  patientId       String
  doctorId        String
  appointmentDate DateTime
  startTime       String
  endTime         String
  duration        Int      @default(30)
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  cancellationReason String?
  consultationFee Decimal? @db.Decimal(10, 2)
  isPaid          Boolean  @default(false)
  reminderSent    Boolean  @default(false)
  checkedInAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?        @relation("UserAppointmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visit           Visit?

  @@index([organizationId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@map("appointments")
}

enum AppointmentType {
  WALK_IN
  ONLINE
  FOLLOW_UP
  EMERGENCY
  TELEMEDICINE
  LAB_REVIEW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ============================================================
// VISITS (Patient Journey)
// ============================================================

model Visit {
  id              String   @id @default(uuid())
  organizationId  String
  patientId       String
  appointmentId   String?   @unique
  visitNumber     String
  visitDate       DateTime @default(now())
  status          VisitStatus @default(REGISTERED)
  type            VisitType @default(OPD)
  departmentId    String?
  doctorId        String?
  chiefComplaint  String?
  symptoms        String?
  diagnosis       String?
  diagnosisCode   String?
  notes           String?
  priority        Priority @default(NORMAL)
  isInsurance     Boolean  @default(false)
  insuranceProvider String?
  insurancePolicyNo String?
  insuranceApprovalNo String?
  insuranceCoverage Decimal? @db.Decimal(10, 2)
  totalAmount     Decimal? @db.Decimal(10, 2) @default(0)
  paidAmount      Decimal? @db.Decimal(10, 2) @default(0)
  balance         Decimal? @db.Decimal(10, 2) @default(0)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("VisitCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  doctor          User?        @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  queue           Queue?
  prescriptions   Prescription[]
  labResults      LabResult[]
  labTestResults  LabTestResult[] @relation("VisitLabTestResults")
  labRequests     LabRequest[]
  radiologyRequests RadiologyRequest[]
  radiologyReports RadiologyReport[] @relation("VisitRadiologyReports")
  soapNotes       SOAPNote[]
  medicalRecords  MedicalRecord[]
  vitalsRecords   VitalsRecord[]
  invoices        Invoice[]
  procedureRequests ProcedureRequest[]
  referrals       Referral[]
  admissionRequests AdmissionRequest[]
  medicalCertificates MedicalCertificate[]
  voiceNotes      VoiceNote[]
  clinicalDecisionSupports ClinicalDecisionSupport[] @relation("VisitCDS")

  @@index([organizationId, visitDate])
  @@index([patientId])
  @@index([doctorId])
  @@map("visits")
}

enum VisitStatus {
  REGISTERED
  IN_QUEUE
  IN_PROGRESS
  LAB_PENDING
  LAB_COMPLETED
  RADIOLOGY_PENDING
  RADIOLOGY_COMPLETED
  PHARMACY_PENDING
  BILLING_PENDING
  COMPLETED
  CANCELLED
}

enum VisitType {
  OPD
  IPD
  EMERGENCY
  TELEMEDICINE
  FOLLOW_UP
  LAB_ONLY
  RADIOLOGY_ONLY
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
  EMERGENCY
}

// ============================================================
// QUEUE MANAGEMENT
// ============================================================

model Queue {
  id              String   @id @default(uuid())
  organizationId  String
  visitId         String   @unique
  patientId       String
  queueType       QueueType
  queueNumber     Int
  priority        Priority @default(NORMAL)
  status          QueueStatus @default(WAITING)
  doctorId        String?
  roomId          String?
  estimatedTime   DateTime?
  calledAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  waitDuration    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visit           Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  room            Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([organizationId, queueType, status])
  @@map("queues")
}

enum QueueType {
  RECEPTION
  DOCTOR
  LABORATORY
  RADIOLOGY
  PHARMACY
  CASHIER
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

model WaitingList {
  id              String   @id @default(uuid())
  organizationId  String
  patientId       String
  doctorId        String
  preferredDate   DateTime?
  preferredTime   String?
  reason          String?
  status          String   @default("PENDING")
  notified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("waiting_list")
}

// ============================================================
// LABORATORY
// ============================================================

model Laboratory {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  type            LabType
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests           Test[]
  labResults      LabResult[]  @relation("LaboratoryLabResults")

  @@map("laboratories")
}

enum LabType {
  GENERAL
  HEMATOLOGY
  BIOCHEMISTRY
  MICROBIOLOGY
  IMMUNOLOGY
  PATHOLOGY
  GENETICS
  URINALYSIS
  HISTOPATHOLOGY
  CYTOLOGY
}

model Test {
  id              String   @id @default(uuid())
  organizationId  String
  laboratoryId    String?
  departmentId    String?
  categoryId      String?
  name            String
  code            String
  description     String?
  sampleType      String?
  sampleVolume    String?
  containerType   String?
  turnaroundTime  Int?
  turnaroundUnit  String?  @default("hours")
  price           Decimal  @db.Decimal(10, 2)
  normalRange     Json?
  instructions    String?
