  type            String
  input           Json
  suggestion      Json
  confidence      Decimal? @db.Decimal(5, 2)
  wasAccepted     Boolean?
  createdById     String?
  createdAt       DateTime @default(now())

  visit           Visit?        @relation("VisitCDS", fields: [visitId], references: [id], onDelete: SetNull)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile @relation("DoctorCDS", fields: [doctorId], references: [id], onDelete: Cascade)
  createdBy       User?         @relation("CDSCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("clinical_decision_support")
}

// ============================================================
// DOCTOR SCHEDULES
// ============================================================

model DoctorSchedule {
  id              String   @id @default(uuid())
  doctorId        String
  organizationId  String
  dayOfWeek       String
  startTime       String
  endTime         String
  slotDuration    Int      @default(30)
  maxPatients     Int      @default(20)
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("UserDoctorSchedule", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorScheduleOverride {
  id              String   @id @default(uuid())
  doctorId        String
  organizationId  String
  date            DateTime
  isAvailable     Boolean  @default(true)
  startTime       String?
  endTime         String?
  reason          String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("UserDoctorScheduleOverride", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("doctor_schedule_overrides")
}

// ============================================================
// FEEDBACK
// ============================================================

model Feedback {
  id              String   @id @default(uuid())
  organizationId  String
  patientId       String
  visitId         String?
  doctorId        String?
  rating          Int
  category        String?
  comment         String?
  isAnonymous     Boolean  @default(false)
  response        String?
  respondedById   String?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  respondedBy     User?        @relation(fields: [respondedById], references: [id], onDelete: SetNull)

  @@map("feedback")
}
