  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderedBy       DoctorProfile @relation("DoctorProcedureRequests", fields: [orderedById], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("UserProcedureRequest", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("procedure_requests")
}

model Referral {
  id              String   @id @default(uuid())
  organizationId  String
  visitId         String
  referredFromId  String
  referredToId    String?
  referredToName  String?
  referredToHospital String?
  reason          String
  urgency         Priority @default(NORMAL)
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  referredFrom    User     @relation("ReferralCreator", fields: [referredFromId], references: [id], onDelete: Cascade)
  referredTo      User?    @relation("ReferralReceiver", fields: [referredToId], references: [id], onDelete: SetNull)
  referredFromDoc DoctorProfile? @relation("ReferralCreatorDoc", fields: [referredFromDocId], references: [id], onDelete: SetNull)
  referredToDoc   DoctorProfile? @relation("ReferralReceiverDoc", fields: [referredToDocId], references: [id], onDelete: SetNull)
  referredFromDocId String?
  referredToDocId   String?

  @@map("referrals")
}

model AdmissionRequest {
  id              String   @id @default(uuid())
  organizationId  String
  visitId         String
  patientId       String
  requestedById   String
  admissionType   String
  reason          String
  urgency         Priority @default(NORMAL)
  status          String   @default("PENDING")
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy     DoctorProfile @relation("DoctorAdmissionRequest", fields: [requestedById], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("UserAdmissionRequest", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("admission_requests")
}

model MedicalCertificate {
  id              String   @id @default(uuid())
  organizationId  String
  visitId         String
  patientId       String
  issuedById      String
  certificateType String
  reason          String
  startDate       DateTime
  endDate         DateTime
  notes           String?
  digitalSignature String?
  createdById     String?
  createdAt       DateTime @default(now())

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  issuedBy        DoctorProfile @relation("DoctorMedicalCertificate", fields: [issuedById], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("UserMedicalCertificate", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("medical_certificates")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id              String   @id @default(uuid())
  organizationId  String?
  userId          String
  title           String
  message         String
  type            NotificationType
  priority        NotificationPriority @default(NORMAL)
  data            Json?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  channel         NotificationChannel @default(IN_APP)
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  APPOINTMENT
  QUEUE
  LAB_RESULT
  PRESCRIPTION
  PAYMENT
  MESSAGE
  SYSTEM
  EMERGENCY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

// ============================================================
// CHAT & MESSAGING
// ============================================================

model ChatRoom {
  id              String   @id @default(uuid())
  organizationId  String
  type            ChatRoomType @default(DIRECT)
  name            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         UserChatRoom[]
  messages        ChatMessage[]
  patientChatRooms PatientChatRoom[]

  @@map("chat_rooms")
}

enum ChatRoomType {
  DIRECT
  GROUP
  PATIENT_DOCTOR
}

model UserChatRoom {
  id              String   @id @default(uuid())
  chatRoomId      String
  userId          String
  joinedAt        DateTime @default(now())
  lastReadAt      DateTime?

  chatRoom        ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@map("user_chat_rooms")
}

model PatientChatRoom {
  id              String   @id @default(uuid())
  chatRoomId      String
  patientId       String

  chatRoom        ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, patientId])
  @@map("patient_chat_rooms")
}

model ChatMessage {
  id              String   @id @default(uuid())
  chatRoomId      String
  senderId        String
  content         String
  type            MessageType @default(TEXT)
  fileUrl         String?
  isEdited        Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chatRoom        ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

// ============================================================
// VIDEO SESSIONS
// ============================================================

model VideoSession {
  id              String   @id @default(uuid())
  organizationId  String
  consultationId  String?
  roomId          String
  hostId          String
  status          VideoSessionStatus @default(SCHEDULED)
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?
  recordingUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host            User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants    VideoParticipant[]

  @@map("video_sessions")
}

enum VideoSessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model VideoParticipant {
  id              String   @id @default(uuid())
  sessionId       String
  userId          String
  joinedAt        DateTime?
  leftAt          DateTime?
  isMuted         Boolean  @default(false)
  isVideoOn       Boolean  @default(true)

  session         VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("video_participants")
}

// ============================================================
// FILES & DOCUMENTS
// ============================================================

model File {
  id              String   @id @default(uuid())
  organizationId  String
  patientId       String?
  uploadedById    String
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  url             String
  thumbnailUrl    String?
  category        FileCategory
  tags            String[]
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@map("files")
}

enum FileCategory {
  MEDICAL_REPORT
  LAB_REPORT
  RADIOLOGY_IMAGE
  PRESCRIPTION
  IDENTIFICATION
  INSURANCE
  PHOTO
  DOCUMENT
  OTHER
}

// ============================================================
// VOICE NOTES
// ============================================================

model VoiceNote {
  id              String   @id @default(uuid())
  visitId         String
  doctorId        String
  transcription   String?
  audioUrl        String
  duration        Int?
  createdAt       DateTime @default(now())

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctor          User     @relation("UserVoiceNote", fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("voice_notes")
}

// ============================================================
// SUBSCRIPTIONS & SaaS
// ============================================================

model Subscription {
  id              String   @id @default(uuid())
  organizationId  String?  @unique
  plan            SubscriptionPlan @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  monthlyPrice    Decimal  @db.Decimal(10, 2)
  annualPrice     Decimal? @db.Decimal(10, 2)
  billingCycle    BillingCycle @default(MONTHLY)
  startDate       DateTime @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  maxUsers        Int      @default(5)
  maxPatients     Int      @default(1000)
  maxStorage      Int      @default(5120)
  features        Json?
  paymentMethod   String?
  lastPaymentAt   DateTime?
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id])
  invoices        SubscriptionInvoice[]

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  TRIAL
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model SubscriptionInvoice {
  id              String   @id @default(uuid())
  subscriptionId  String
  amount          Decimal  @db.Decimal(10, 2)
  status          String   @default("PENDING")
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}

// ============================================================
// SYSTEM & ADMINISTRATION
// ============================================================

model OrganizationSetting {
  id              String   @id @default(uuid())
  organizationId  String
  key             String
  value           Json
  category        String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model AuditLog {
  id              String   @id @default(uuid())
  organizationId  String?
  userId          String?
  action          String
  entity          String
  entityId        String?
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String
  action          String
  entity          String
  entityId        String?
  details         Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model Report {
  id              String   @id @default(uuid())
  organizationId  String
  generatedById   String
  reportType      String
  title           String
  parameters      Json?
  data            Json?
  format          String   @default("JSON")
  fileUrl         String?
  status          String   @default("GENERATED")
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy     User         @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ============================================================
// PATIENT PORTAL SPECIFIC
// ============================================================

model EmergencyContact {
  id              String   @id @default(uuid())
  patientId       String
  organizationId  String
  name            String
  relationship    String
  phone           String
  email           String?
  address         String?
  isPrimary       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model FamilyAccount {
  id              String   @id @default(uuid())
  organizationId  String
  primaryPatientId String
  linkedPatientId String
  relationship    String
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())

  primaryPatient  Patient  @relation("FamilyAccount", fields: [primaryPatientId], references: [id], onDelete: Cascade)
  linkedPatient   Patient  @relation("patientFamilyAccounts", fields: [linkedPatientId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([primaryPatientId, linkedPatientId])
  @@map("family_accounts")
}

model FavoriteDoctor {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String
  organizationId  String
  createdAt       DateTime @default(now())

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("favorite_doctors")
}

model MedicationReminder {
  id              String   @id @default(uuid())
  patientId       String
  organizationId  String
  medicationName  String
  dosage          String
  frequency       String
  time            String
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("medication_reminders")
}

model VaccinationRecord {
  id              String   @id @default(uuid())
  patientId       String
  organizationId  String
  vaccineName     String
  doseNumber      Int
  dateGiven       DateTime
  nextDoseDate    DateTime?
  batchNumber     String?
  administeredBy  String?
  site            String?
  notes           String?
  createdAt       DateTime @default(now())

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("vaccination_records")
}

